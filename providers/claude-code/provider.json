{
  "$schema": "../../schema/provider.schema.json",
  "schemaVersion": 1,
  "id": "claude-code",
  "name": "Claude Code",
  "icon": "icon.svg",
  "family": "claude-jsonl",
  "assets": {
    "sessions": {
      "roots": {
        "win32": ["~/.claude/projects"],
        "darwin": ["~/.claude/projects"],
        "linux": ["~/.claude/projects"]
      },
      "layout": { "sessionGlob": "*/*.jsonl" },
      "title": { "fields": ["aiTitle", "customTitle"], "fromFirstUserMessage": true },
      "ignore": {
        "sessions": [
          { "cwdContains": "claude-sandbox-status-" }
        ]
      }
    }
  },
  "fileLinks": {
    "assistant": [
      { "syntax": "markdown-link", "accept": ["absolute-path"] }
    ]
  },
  "capabilities": { "resume": true, "images": true, "subagents": false, "reasoning": true }
}
