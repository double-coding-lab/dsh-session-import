{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/double-coding-lab/dsh-session-import/schema/provider.schema.json",
  "title": "dsh-session-import provider descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "family", "roots", "layout"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "稳定标识，同时是 providers/<id>/ 目录名"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "family": {
      "type": "string",
      "enum": ["claude-jsonl", "codex-jsonl"],
      "description": "解析器家族；同族工具共享实现，新增同族 provider 无需写代码"
    },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "win32": { "$ref": "#/$defs/paths" },
        "darwin": { "$ref": "#/$defs/paths" },
        "linux": { "$ref": "#/$defs/paths" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionGlob"],
      "properties": {
        "sessionGlob": {
          "type": "string",
          "description": "相对 root 的会话文件匹配式，例如 */*.jsonl"
        },
        "subagentGlob": {
          "type": "string",
          "description": "可选：子 agent 会话匹配式"
        }
      }
    },
    "cwd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "description": "取工作目录的记录路径，例如 workspace-directories.directories[0]"
        }
      }
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "items": { "type": "string" },
          "description": "标题候选字段，按序取第一个非空值"
        },
        "fromFirstUserMessage": {
          "type": "boolean",
          "description": "无显式标题时是否用首条用户消息兜底"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resume": { "type": "boolean" },
        "images": { "type": "boolean" },
        "subagents": { "type": "boolean" },
        "reasoning": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
