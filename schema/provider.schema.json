{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/double-coding-lab/dsh-session-import/schema/provider.schema.json",
  "title": "dsh-session-import provider descriptor",
  "description": "纯数据描述：一个第三方工具把会话与记忆放在哪、用什么格式族解析。新增工具不需要写代码。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "family", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "稳定标识，同时是 providers/<id>/ 目录名"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "family": {
      "type": "string",
      "enum": ["claude-jsonl", "codex-jsonl"],
      "description": "会话解析器家族；同族工具共享实现"
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sessions": { "$ref": "#/$defs/sessionsAsset" },
        "memory": { "$ref": "#/$defs/memoryAsset" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resume": { "type": "boolean" },
        "images": { "type": "boolean" },
        "subagents": { "type": "boolean" },
        "reasoning": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "win32": { "$ref": "#/$defs/paths" },
        "darwin": { "$ref": "#/$defs/paths" },
        "linux": { "$ref": "#/$defs/paths" }
      }
    },
    "sessionsAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "layout"],
      "properties": {
        "roots": { "$ref": "#/$defs/roots" },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sessionGlob"],
          "properties": {
            "sessionGlob": { "type": "string" },
            "subagentGlob": { "type": "string" }
          }
        },
        "cwd": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": { "type": "string", "description": "例如 workspace-directories.directories[0]" }
          }
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fields": { "type": "array", "items": { "type": "string" } },
            "fromFirstUserMessage": { "type": "boolean" }
          }
        }
      }
    },
    "memoryAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "globalRoots": { "$ref": "#/$defs/paths" },
        "projectRoots": {
          "$ref": "#/$defs/paths",
          "description": "支持 <项目> 占位符，按会话 cwd 解析"
        },
        "format": {
          "type": "string",
          "enum": ["markdown-frontmatter"],
          "description": "记忆文件格式；目前只有带 YAML frontmatter 的 Markdown"
        }
      }
    }
  }
}
