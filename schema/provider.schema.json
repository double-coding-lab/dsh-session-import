{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/double-coding-lab/dsh-session-import/schema/provider.schema.json",
  "title": "dsh-session-import provider descriptor",
  "description": "纯数据描述：一个第三方工具把会话放在哪、用什么格式族解析。新增工具不需要写代码。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "family", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "稳定标识，同时是 providers/<id>/ 目录名"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "icon": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+\\.(png|svg|webp|ico|jpg)$",
      "description": "官方应用图标，相对 provider 目录的文件名"
    },
    "family": {
      "type": "string",
      "enum": ["claude-jsonl", "codex-jsonl", "codex-db"],
      "description": "会话解析器家族；同族工具共享实现"
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sessions": { "$ref": "#/$defs/sessionsAsset" }
      }
    },
    "fileLinks": {
      "type": "object",
      "additionalProperties": false,
      "description": "该 provider 的本地文件链接写法；由通用适配器改写为 DSH 原生可点击文件，规则本身不写代码",
      "properties": {
        "assistant": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileLinkRule" }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resume": { "type": "boolean" },
        "images": { "type": "boolean" },
        "subagents": { "type": "boolean" },
        "reasoning": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "fileLinkRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["syntax", "accept"],
      "properties": {
        "syntax": {
          "const": "markdown-link",
          "description": "源文本中的链接语法；新增语法由适配器扩展"
        },
        "accept": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["file-url", "absolute-path", "relative-path"] },
          "description": "哪些链接目标算本地文件；relative-path 基于会话 cwd 解析"
        },
        "extensions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" },
          "description": "可选扩展名白名单，如 [\".md\", \".pdf\"]；为空表示不限"
        }
      }
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "win32": { "$ref": "#/$defs/paths" },
        "darwin": { "$ref": "#/$defs/paths" },
        "linux": { "$ref": "#/$defs/paths" }
      }
    },
    "sessionsAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "layout"],
      "properties": {
        "roots": { "$ref": "#/$defs/roots" },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sessionGlob"],
          "properties": {
            "sessionGlob": { "type": "string" },
            "sessionGlobs": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "description": "额外转录 glob（同一 root 下不同层级，如 Codex 的归档目录）"
            },
            "subagentGlob": { "type": "string" },
            "database": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "history"],
              "properties": {
                "state": { "type": "string", "description": "线程/项目元数据 SQLite，相对 provider 根目录" },
                "history": { "type": "string", "description": "线程消息 SQLite，相对 provider 根目录" },
                "globalState": { "type": "string", "description": "桌面端全局状态 JSON（项目与线程映射）" }
              }
            }
          }
        },
        "cwd": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": { "type": "string", "description": "例如 workspace-directories.directories[0]" }
          }
        },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fields": { "type": "array", "items": { "type": "string" } },
            "fromFirstUserMessage": { "type": "boolean" }
          }
        },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["branch", "segments"],
              "description": "branch=rewind 分叉只显示最新分支；segments=续接文件按顺序合并为一个会话"
            }
          }
        },
        "ignore": {
          "type": "object",
          "additionalProperties": false,
          "description": "机器遥测、内部探针类转录不当作可导入会话",
          "properties": {
            "titlePrefixes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "description": "解析出的标题以这些前缀开头时忽略该转录"
            },
            "sessions": {
              "type": "array",
              "description": "按会话元数据忽略；一条规则内所有条件需同时满足",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "cwdContains": {
                    "type": "string",
                    "minLength": 1,
                    "description": "会话 cwd 包含该子串（忽略大小写）"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "description": "会话标题完全等于该值"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
